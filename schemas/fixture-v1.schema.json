{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MadhavSekhri/Agent-Audit-Kit/blob/main/schemas/fixture-v1.schema.json",
  "title": "Agent Audit Kit fixture schema v1",
  "description": "Deterministic recorded agent response/tool assertions. No model execution.",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$",
      "maxLength": 80
    },
    "shortStrings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "response"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "response": {
          "type": "string",
          "maxLength": 131072
        },
        "expected_contains": {
          "$ref": "#/$defs/shortStrings"
        },
        "forbidden_contains": {
          "$ref": "#/$defs/shortStrings"
        },
        "secret_markers": {
          "$ref": "#/$defs/shortStrings"
        },
        "allowed_tools": {
          "$ref": "#/$defs/shortStrings"
        },
        "forbidden_tools": {
          "$ref": "#/$defs/shortStrings"
        },
        "expected_tool_sequence": {
          "$ref": "#/$defs/shortStrings"
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "tool_calls": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/identifier"
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
